# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_store

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL of this API (used to build absolute image URLs)
API_BASE_URL=http://localhost:8000

# Public base URL of the frontend (used to build store share links / QR codes)
FRONTEND_BASE_URL=http://localhost:5173

# Local upload directory (relative to backend/)
UPLOAD_DIR=uploads

# Platform admin bootstrap (created by `python -m app.seed` if it doesn't exist)
PLATFORM_ADMIN_EMAIL=admin@whatsapporderstore.com
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
